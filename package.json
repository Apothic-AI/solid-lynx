{
  "name": "solid-lynx",
  "version": "0.1.0",
  "description": "A Solid renderer for Lynx Element PAPI",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Apothic-AI/solid-lynx.git"
  },
  "keywords": [
    "solid",
    "solidjs",
    "lynx",
    "renderer",
    "element-papi",
    "native-ui"
  ],
  "type": "module",
  "sideEffects": false,
  "packageManager": "pnpm@12.9.1",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "import": "./dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-dev-runtime.d.ts",
      "import": "./dist/jsx-dev-runtime.js"
    },
    "./parity": {
      "types": "./dist/parity.d.ts",
      "import": "./dist/parity.js"
    },
    "./rspeedy": {
      "types": "./dist/rspeedy.d.ts",
      "import": "./dist/rspeedy.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "pnpm build && vitest run && pnpm typecheck:consumer",
    "typecheck": "pnpm build && tsc --noEmit && pnpm typecheck:consumer",
    "typecheck:consumer": "tsc --noEmit -p test/consumer/tsconfig.json && tsc --noEmit -p test/consumer/tsconfig.dev.json",
    "web:build": "pnpm build && pnpm exec rspeedy build --root examples/lynx-for-web",
    "web:serve": "vite examples/lynx-for-web/site --config examples/lynx-for-web/site/vite.config.ts --force --host 127.0.0.1 --port ${PLAYWRIGHT_PORT:-4173} --strictPort",
    "web:test": "playwright test --config playwright.config.ts",
    "native:build": "pnpm build && pnpm exec rspeedy build --root examples/lynx-for-native"
  },
  "peerDependencies": {
    "solid-js": "^1.9.15",
    "@rsbuild/core": "^2.0.0",
    "@rsbuild/plugin-babel": "^2.1.0",
    "babel-preset-solid": "^1.9.15"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@lynx-js/lynx-core": "0.1.4",
    "@lynx-js/rsbuild-plugin": "0.1.3",
    "@lynx-js/rspeedy": "0.18.0",
    "@lynx-js/vanilla-rsbuild-plugin": "0.1.2",
    "@lynx-js/web-core": "0.26.2",
    "@playwright/test": "^1.63.0",
    "@rsbuild/core": "2.2.11",
    "@rsbuild/plugin-babel": "2.1.0",
    "@types/node": "^22.15.30",
    "babel-preset-solid": "1.9.15",
    "solid-js": "1.9.15",
    "typescript": "^5.8.3",
    "vite": "^8.3.1",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "peerDependenciesMeta": {
    "@rsbuild/core": {
      "optional": true
    },
    "@rsbuild/plugin-babel": {
      "optional": true
    },
    "babel-preset-solid": {
      "optional": true
    }
  }
}
