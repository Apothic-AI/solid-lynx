{
  "name": "solid-lynx",
  "version": "0.1.0",
  "description": "A Solid renderer for Lynx Element PAPI",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Apothic-AI/solid-lynx.git"
  },
  "keywords": [
    "solid",
    "solidjs",
    "lynx",
    "renderer",
    "element-papi",
    "native-ui"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "import": "./dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-dev-runtime.d.ts",
      "import": "./dist/jsx-dev-runtime.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "web:serve": "vite --root examples/lynx-for-web/site --host 127.0.0.1 --port 4173 --strictPort",
    "web:test": "playwright test --config playwright.config.ts"
  },
  "peerDependencies": {
    "solid-js": "^1.9.0"
  },
  "devDependencies": {
    "@lynx-js/web-core": "^0.26.2",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.15.30",
    "solid-js": "^1.9.9",
    "typescript": "^5.8.3",
    "vite": "^8.3.1",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
